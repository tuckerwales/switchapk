# switchapk - Nintendo Switch build (devkitA64 + libnx): build/switch/switchapk.nro
#
#   python3 tools/fetch_toolchains.py devkitpro
#   make            # host build first: it produces build/java/framework.dex
#   make -f Makefile.switch
#
# The NRO carries framework.dex and framework-res.apk in its romfs.

DEVKITPRO ?= $(CURDIR)/build/toolchains/devkitpro/opt/devkitpro
export DEVKITPRO
PREFIX := $(DEVKITPRO)/devkitA64/bin/aarch64-none-elf-
CC := $(PREFIX)gcc
BUILD := build/switch
TOOLS := $(DEVKITPRO)/tools/bin

APP_TITLE := switchapk
APP_AUTHOR := switchapk
APP_VERSION := 0.1.0

ARCH := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE
CFLAGS := -O2 -g -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers \
          -fno-strict-aliasing -fwrapv -ffunction-sections $(ARCH) -D__SWITCH__ \
          -Isrc -Ithird_party -I$(DEVKITPRO)/libnx/include -I$(DEVKITPRO)/portlibs/switch/include
ASFLAGS := $(ARCH) -D__SWITCH__
LDFLAGS := -specs=$(DEVKITPRO)/libnx/switch.specs -g $(ARCH) -Wl,-Map,$(BUILD)/switchapk.map
LIBS := -L$(DEVKITPRO)/portlibs/switch/lib -L$(DEVKITPRO)/libnx/lib -lz -lnx -lm
# OpenGL ES (WS8) through Mesa (switch-mesa portlib, C++: needs libstdc++) when installed; without it GL
# reports itself unavailable
ifneq ($(wildcard $(DEVKITPRO)/portlibs/switch/lib/libEGL.a),)
CFLAGS += -DSA_HAVE_EGL
LIBS := -L$(DEVKITPRO)/portlibs/switch/lib -L$(DEVKITPRO)/libnx/lib -lEGL -lglapi -ldrm_nouveau -lstdc++ -lz -lnx -lm
endif

SRCS := $(filter-out src/app/main_host.c src/platform/platform_headless.c, \
          $(wildcard src/core/*.c src/vm/*.c src/native/*.c src/nativeloader/*.c src/android/*.c src/gfx/*.c \
                     src/platform/*.c src/app/*.c))
ASMS := $(wildcard src/vm/*.S)
OBJS := $(SRCS:%.c=$(BUILD)/%.o) $(ASMS:%.S=$(BUILD)/%.o)
DEPS := $(OBJS:.o=.d)

ROMFS := $(BUILD)/romfs
FRAMEWORK_DEX := build/java/framework.dex
FRAMEWORK_RES := build/toolchains/framework-res.apk

all: $(BUILD)/switchapk.nro

$(BUILD)/switchapk.nro: $(BUILD)/switchapk.elf $(BUILD)/switchapk.nacp $(ROMFS)/framework.dex $(ROMFS)/framework-res.apk
	$(TOOLS)/elf2nro $< $@ --icon=$(DEVKITPRO)/libnx/default_icon.jpg --nacp=$(BUILD)/switchapk.nacp --romfsdir=$(ROMFS)

SQLITE_SRC := third_party/sqlite/sqlite3.c
SQLITE_OBJ := $(BUILD)/third_party/sqlite/sqlite3.o
# OS_OTHER: the unix VFS wants mmap and host locking. sqlite_vfs_switch.c is the file layer,
# and it installs pthread mutexes before the first open. WAL is omitted with that VFS.
SQLITE_CFLAGS := -DSQLITE_THREADSAFE=1 -DSQLITE_OMIT_LOAD_EXTENSION \
	-DSQLITE_OS_OTHER=1 -DSQLITE_OMIT_WAL -DSQLITE_MAX_MMAP_SIZE=0 \
	-Wno-unused-function -Wno-unused-variable -Wno-unused-but-set-variable \
	-Wno-implicit-fallthrough -Wno-sign-compare -Wno-cast-function-type

$(SQLITE_SRC):
	@echo "missing $@; run: python3 tools/fetch_toolchains.py sqlite" && false

$(SQLITE_OBJ): $(SQLITE_SRC)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(SQLITE_CFLAGS) -c -o $@ $<

$(BUILD)/switchapk.elf: $(OBJS) $(SQLITE_OBJ)
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)

$(BUILD)/switchapk.nacp:
	@mkdir -p $(BUILD)
	$(TOOLS)/nacptool --create "$(APP_TITLE)" "$(APP_AUTHOR)" "$(APP_VERSION)" $@

$(ROMFS)/framework.dex: $(FRAMEWORK_DEX)
	@mkdir -p $(ROMFS)
	cp $< $@

$(ROMFS)/framework-res.apk: $(FRAMEWORK_RES)
	@mkdir -p $(ROMFS)
	cp $< $@

$(FRAMEWORK_DEX):
	@echo "build/java/framework.dex is missing: run make (the host build) first" && false

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

$(BUILD)/%.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(ASFLAGS) -c -o $@ $<

clean:
	rm -rf $(BUILD)

.PHONY: all clean
-include $(DEPS)

# SD card layout: unzip build/switch/switchapk-sd.zip at the root of the SD card.
# Every sample under tests/apps (a directory with AndroidManifest.xml) goes in switch/switchapk/apks.
# Apps with native code (native/build.sh, needs clang and lld) are always rebuilt with arm64-v8a libraries
# (NDK_ARM64=1): a host build only carries x86_64 ones.
SAMPLE_APPS := $(sort $(patsubst tests/apps/%/AndroidManifest.xml,%,$(wildcard tests/apps/*/AndroidManifest.xml)))
SD := $(BUILD)/sd

dist: $(BUILD)/switchapk.nro
	rm -rf $(SD) $(BUILD)/switchapk-sd.zip
	mkdir -p $(SD)/switch/switchapk/apks
	cp $(BUILD)/switchapk.nro $(SD)/switch/switchapk/switchapk.nro
	for app in $(SAMPLE_APPS); do \
	    if [ -x tests/apps/$$app/native/build.sh ]; then \
	        NDK_ARM64=1 ./tools/build_apk.sh tests/apps/$$app >/dev/null || exit 1; \
	    elif [ ! -f build/apps/$$app/$$app.apk ]; then \
	        ./tools/build_apk.sh tests/apps/$$app >/dev/null || exit 1; \
	    fi; \
	    cp build/apps/$$app/$$app.apk $(SD)/switch/switchapk/apks/; \
	done
	cd $(SD) && zip -qr ../switchapk-sd.zip switch
	@echo "$(BUILD)/switchapk-sd.zip: unzip at the root of the SD card"

.PHONY: dist
