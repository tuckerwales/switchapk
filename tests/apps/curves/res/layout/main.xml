<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101820">
    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical">
        <View android:id="@+id/linear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:background="#FFE53935"
            android:defaultFocusHighlightEnabled="false" />
        <View android:id="@+id/over"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="48dp"
            android:layout_marginBottom="8dp"
            android:background="#FF43A047"
            android:defaultFocusHighlightEnabled="false" />
        <View android:id="@+id/ant"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="48dp"
            android:layout_marginBottom="8dp"
            android:background="#FF1E88E5"
            android:defaultFocusHighlightEnabled="false" />
        <View android:id="@+id/bounce"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="48dp"
            android:layout_marginBottom="8dp"
            android:background="#FFFFC107"
            android:defaultFocusHighlightEnabled="false" />
        <View android:id="@+id/cycle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="48dp"
            android:layout_marginBottom="8dp"
            android:background="#FFAB47BC"
            android:defaultFocusHighlightEnabled="false" />
        <View android:id="@+id/path"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="48dp"
            android:background="#FFFF6F00"
            android:defaultFocusHighlightEnabled="false" />
    </LinearLayout>
    <ImageView android:id="@+id/morph"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_marginLeft="520dp"
        android:layout_marginTop="24dp"
        android:padding="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/morph" />
</FrameLayout>
