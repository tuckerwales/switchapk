<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101820">
    <View android:id="@+id/state"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:background="#FFFFF59D"
        android:clickable="true"
        android:defaultFocusHighlightEnabled="false"
        android:stateListAnimator="@animator/press" />
    <LinearLayout android:id="@+id/column"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="160dp"
        android:orientation="vertical"
        android:layoutAnimation="@anim/column">
        <View android:id="@+id/row0"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:background="#FFE53935" />
        <View android:id="@+id/row1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="8dp"
            android:background="#FF43A047" />
        <View android:id="@+id/row2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="#FF1E88E5" />
    </LinearLayout>
    <ImageView android:id="@+id/bar"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_marginLeft="500dp"
        android:layout_marginTop="24dp"
        android:padding="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/bar" />
    <FrameLayout android:id="@+id/fade"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginLeft="500dp"
        android:layout_marginTop="140dp" />
</FrameLayout>
